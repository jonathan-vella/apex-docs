---
import { SITE_BASE } from "../../data/siteConfig.mjs";
import { demoStats, demoSteps } from "../../data/demoSteps.mjs";

const journeySteps = demoSteps.filter((step) => step.id !== "overview");
const firstStep = journeySteps[0];
const reviewStep = journeySteps[journeySteps.length - 1];
---

<section class="scenario-frame demo-overview-hero not-content">
  <div class="scenario-frame__head">
    <div class="section-label">April 2026 case study</div>
    <h2>Read the decisions and results from a catering workload</h2>
    <p>
      Il-Pastizzeria ta' Mario recorded requirements,
      architecture, governance, planning, code generation, deployment, and
      as-built documentation during an April 2026 run.
    </p>
  </div>

  <div class="scenario-frame__body">
    <div class="demo-overview-hero__layout">
      <div class="demo-overview-hero__copy">
        <p class="demo-overview-hero__lede">
          Use this record to compare requirements, design decisions, code, and
          observed results. It does not describe every rule in current APEX.
        </p>
        <p>
          Resource provisioning succeeded. Production and staging application
          checks returned HTTP 503. Read those limitations alongside the deployment
          summary rather than treating provisioning as application success.
        </p>

        <div class="landing-hero__actions demo-overview-actions">
          <a class="sl-link-button primary not-content" href={firstStep.href}>
            Start the walkthrough
          </a>
          <a class="sl-link-button minimal not-content" href={reviewStep.href}>
            Read the review findings
          </a>
        </div>
      </div>

      <div class="demo-proof-grid" aria-label="Case study facts">
        {demoStats.map((stat) => (
          <div class="demo-proof-card">
            <span>{stat.label}</span>
            <strong>{stat.value}</strong>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="scenario-frame demo-overview-story not-content">
  <div class="scenario-frame__head">
    <div class="section-label">Scenario</div>
    <h2>A Maltese catering outlet needs an online ordering app on Azure</h2>
    <p>
      The owner of a small catering outlet in Malta wants to sell pastizzi, Cisk,
      and Kinnie online. Payment is strictly cash on delivery. The app is a
      containerized React SPA backed by Azure Table Storage.
    </p>
  </div>

  <div class="scenario-frame__body demo-overview-story__grid">
    <div class="demo-overview-story__visual">
      <img
        src={`${SITE_BASE}/demo/03-des-diagram.svg`}
        alt="Architecture overview for the Il-Pastizzeria ta' Mario demo workload"
      />
    </div>

    <div class="scenario-panel demo-overview-story__panel">
      <div class="scenario-panel__label">What the record contains</div>
      <ul class="scenario-checklist">
        <li>Requirements and the original S1 design assumptions.</li>
        <li>Policy discovery and review findings from the recorded run.</li>
        <li>The P0v3 deployment result and unresolved application-health failures.</li>
      </ul>
    </div>
  </div>
</section>

<section class="scenario-frame demo-overview-steps not-content">
  <div class="scenario-frame__head">
    <div class="section-label">Walkthrough</div>
    <h2>Read the recorded steps</h2>
    <p>
      Open a step to inspect its generated records. Summaries below describe
      this case study, not the current workflow contract.
    </p>
  </div>

  <div class="scenario-frame__body">
    <div class="demo-step-grid">
      {journeySteps.map((step) => (
        <a class="demo-step-card" href={step.href}>
          <div class="demo-step-card__head">
            <span class="demo-step-card__step">{step.stepLabel}</span>
            <span class="demo-step-card__agent">{step.agent}</span>
          </div>
          <h3>{step.shortTitle}</h3>
          <p>{step.summary}</p>
          <dl class="demo-step-card__meta">
            <div>
              <dt>Output</dt>
              <dd>{step.artifact}</dd>
            </div>
            <div>
              <dt>Focus</dt>
              <dd>{step.focus}</dd>
            </div>
          </dl>
          {step.sections && (
            <div class="demo-step-card__sections">
              <span>Includes</span>
              <ul>
                {step.sections.map((section) => (
                  <li>{section}</li>
                ))}
              </ul>
            </div>
          )}
          <span class="demo-step-card__cta">Open step</span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="scenario-frame demo-overview-trust not-content">
  <div class="scenario-frame__head">
    <div class="section-label">Editorial scope</div>
    <h2>Historical outputs remain unchanged</h2>
    <p>
      Introductions, metadata, and navigation distinguish the historical run
      from current guidance. Generated artifact bodies retain their original wording.
    </p>
  </div>

  <div class="scenario-frame__body">
    <div class="scenario-frame__columns demo-overview-trust__columns">
      <div class="scenario-panel">
        <div class="scenario-panel__label">What changed</div>
        <p>
          The case-study framing states its date, observed failures, and differences
          from current approval rules.
        </p>
      </div>
      <div class="scenario-panel">
        <div class="scenario-panel__label">What stayed intact</div>
        <p>
          Generated records, cost figures, review findings, and imported assets.
          Their preservation is not a claim that every historical statement is correct.
        </p>
      </div>
    </div>
  </div>
</section>
