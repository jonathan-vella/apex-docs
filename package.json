{
  "name": "apex-docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "source:prepare": "node scripts/prepare-source.mjs",
    "source:update": "node scripts/update-source.mjs",
    "source:impact": "node scripts/source-impact.mjs",
    "prebuild": "node scripts/generate-metadata.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:setup": "python3 -m pip install diagrams==0.25.1",
    "test:browser": "playwright test",
    "check:links": "node check-links.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:external-links": "node scripts/check-external-links.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "PUBLIC_GIT_SHA=$(git rev-parse --short HEAD 2>/dev/null || echo dev) PUBLIC_BUILD_DATE=$(date -u +%Y-%m-%d) astro build",
    "preview": "node scripts/preview.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/starlight": "^0.41.7",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "astro": "^7.2.8",
    "rehype-mermaid-lite": "^1.0.0",
    "sharp": "^0.35.4",
    "starlight-links-validator": "^0.25.3"
  },
  "overrides": {
    "devalue": "^5.9.2",
    "nanoid": "3.3.18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.63.0",
    "js-yaml": "^4.3.2",
    "jsdom": "^30.1.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  }
}
